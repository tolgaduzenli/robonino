NEXT_PUBLIC_SITE_URL=https://www.robonino.com

# Optional: Google reCAPTCHA v3 for the contact form. Without these, the
# form still has honeypot + timing spam checks, just not the reCAPTCHA score
# check. Create a v3 site at https://www.google.com/recaptcha/admin/create
# (type: reCAPTCHA v3, domains: robonino.com + localhost) and set both keys
# here and in the Vercel project's env vars.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Contact form email (Resend). Without RESEND_API_KEY, submissions are only
# console.logged (no email sent) — fine for local dev, not for production.
# Sign up at https://resend.com, verify the robonino.com domain there (add
# the DNS records Resend gives you at your domain registrar), create an API
# key, and set it here and in the Vercel project's env vars.
RESEND_API_KEY=
# Must be an address at a domain verified in Resend; doesn't need to be a
# real mailbox (no one needs to log into it — replies go to CONTACT_TO_EMAIL
# via the reply-to header set on each email).
CONTACT_FROM_EMAIL="Robonino Website <noreply@robonino.com>"
# Where submissions land. Defaults to info@robonino.com if unset.
CONTACT_TO_EMAIL=info@robonino.com
